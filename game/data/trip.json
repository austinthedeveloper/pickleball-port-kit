      {"who": "partner", "lines": ["WE'LL FIND BETTER ON THE WAY.", "WE ALWAYS DO."]}
    ],
    "partner_start": [
      [{"who": "partner", "lines": ["ROAD TRIP! I PACKED SANDWICHES,", "A MAP AND FOURTEEN DAD JOKES."]}, {"who": "you", "lines": ["ONLY FOURTEEN?"]}, {"who": "partner", "lines": ["THE REST ARE IN THE GLOVEBOX."]}],
      [{"who": "partner", "lines": ["I'VE DRIVEN THIS ROAD SINCE 1962,", "DEAR. I KNOW EVERY REST STOP."]}, {"who": "you", "lines": ["EVERY ONE?"]}, {"who": "partner", "lines": ["AND WHICH ONES HAVE THE GOOD PIE."]}],
      [{"who": "partner", "lines": ["BRO. A VAN. A ROAD. A TROPHY."]}, {"who": "you", "lines": ["THAT'S THE PLAN."]}, {"who": "partner", "lines": ["I BROUGHT SIX SHAKES FOR THE", "TRIP. FOR THE FIRST HOUR."]}],
      [{"who": "partner", "lines": ["A VAN IS JUST A SHIP WITH WHEELS.", "HOIST THE PADDLE BAG!"]}, {"who": "you", "lines": ["IT'S STRAPPED TO THE ROOF RACK."]}, {"who": "partner", "lines": ["THEN WE SAIL AT DAWN. OR NOW."]}],
      [{"who": "partner", "lines": ["I'LL SIT IN THE BACK. AWAY FROM", "THE WINDOWS. AND THE SUN."]}, {"who": "you", "lines": ["IT'S A BEACH TOURNAMENT."]}, {"who": "partner", "lines": ["I'M AWARE. I BROUGHT AN UMBRELLA."]}],
      [{"who": "partner", "lines": ["NO WAVES THIS WEEK, SO... ROAD", "TRIP! WHICH WAY'S THE BEACH?"]}, {"who": "you", "lines": ["ALL THE WAY. THAT'S THE POINT."]}, {"who": "partner", "lines": ["RADICAL. WAKE ME AT THE OCEAN."]}],
      [{"who": "partner", "lines": ["I LEFT MY TWIN A NOTE.", "THEY'LL BE FINE. PROBABLY."]}, {"who": "you", "lines": ["WON'T THEY BE AT THE SUMMER OPEN?"]}, {"who": "partner", "lines": ["...WE'LL CROSS THAT BRIDGE."]}],
      [{"who": "partner", "lines": ["DEFENDING MY OWN TITLE FROM THE", "OTHER SIDE OF THE NET. FUNNY."]}, {"who": "you", "lines": ["WHO PLAYS FOR THE CHAMPS, THEN?"]}, {"who": "partner", "lines": ["MY PARTNER FOUND SOMEONE.", "WE'LL SEE IF THEY'RE ANY GOOD."]}]
    ],
