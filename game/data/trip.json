    "teams": [
      [{"who": "captain", "lines": ["DAD JOKES INCOMING, SPORT!", "WHAT DO YOU CALL A VAN ON A COURT?"]}, {"who": "mate", "lines": ["DAD, NO."]}],
      [{"who": "captain", "lines": ["WE'RE DRIVING TO FLORIDA, DEAR.", "WE STOP AT EVERY COURT ON THE WAY."]}, {"who": "partner", "lines": ["THAT'S A LOT OF COURTS."]}, {"who": "mate", "lines": ["WE'VE PLAYED SINCE 1962. WE HAVE TIME."]}],
