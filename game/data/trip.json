      [{"who": "captain", "lines": ["ARR! WE'RE BETWEEN SHIPS.", "THIS COURT BE OUR SHIP NOW."]}, {"who": "mate", "lines": ["PREPARE TO BE BOARDED!"]}],
      [{"who": "captain", "lines": ["WE ONLY TRAVEL BY NIGHT.", "THE SUN IS SO... CHEERFUL."]}, {"who": "mate", "lines": ["THE KITCHEN IS OUR CRYPT."]}],
      [{"who": "captain", "lines": ["THE WAVES ARE FLAT, DUDE.", "SO WE'RE CHASING COURTS INSTEAD."]}, {"who": "mate", "lines": ["COWABUNGA!"]}],
      [{"who": "captain", "lines": ["WE'RE ON THE SAME ROAD AS YOU.", "SAME TOURNAMENT TOO."]}, {"who": "mate", "lines": ["DOUBLE TROUBLE. READY?"]}],
      [{"who": "captain", "lines": ["SO YOU'RE THE ONES EVERYONE'S", "TALKING ABOUT ON THE COAST ROAD."]}, {"who": "mate", "lines": ["THE TITLE STAYS WITH US."]}, {"who": "partner", "lines": ["WE'LL SEE ABOUT THAT."]}],
      [{"who": "captain", "lines": ["NOBODY DRIVES THIS ROAD BY", "ACCIDENT. ONE GAME. YOU TWO, ME."]}]
    ],
    "won": [
      {"who": "partner", "lines": ["WE DID IT! THE SUMMER OPEN!", "WAIT TILL THEY HEAR ABOUT THIS", "BACK HOME."]},
      {"who": "you", "lines": ["SAME TIME NEXT SUMMER?"]},
      {"who": "partner", "lines": ["I'LL BRING THE MIXTAPE."]}
